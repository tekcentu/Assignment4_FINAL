/* CE4011 Assignment 4 — 2D Structural Analysis
 * Class diagram (Graphviz DOT), grounded in the actual source code.
 * Render:  dot -Tpng docs/uml/class_diagram.dot -o docs/uml/class_diagram.png
 *
 * Package mapping (real names):
 *   computational engine -> structural_analysis/*.py
 *   editor (Qt-free)     -> structural_analysis/gui_common/*.py
 *   gui (PyQt6)          -> structural_analysis/gui_qt/*.py
 */
digraph CE4011 {
    rankdir=BT;
    graph [fontname="Helvetica", fontsize=11, splines=true, nodesep=0.4, ranksep=0.7];
    node  [shape=record, fontname="Helvetica", fontsize=9, style=filled, fillcolor="#f5f5f5"];
    edge  [fontname="Helvetica", fontsize=8];

    /* ---------------- Domain model (model.py) ---------------- */
    StructuralModel [fillcolor="#dbe9ff", label="{StructuralModel|+ title\l+ nodes: dict\l+ materials: dict\l+ sections: dict\l+ elements: list\l+ supports: dict\l+ nodal_loads: list\l+ load_cases: dict\l+ load_combinations: dict\l+ joint_masses: dict\l+ modal_mass_source\l+ include_self_weight\l|+ node(id)\l+ support_for(id)\l+ node_ids\l}"];
    "Node"   [label="{Node «frozen»|+ id\l+ x\l+ y\l}"];
    Material [label="{Material «frozen»|+ id\l+ name\l+ E\l+ alpha\l+ density\l+ nu\l|+ G\l}"];
    Section  [label="{Section «frozen»|+ id\l+ material_id\l+ A\l+ I\l+ depth\l+ shape_type\l}"];
    Support  [label="{Support «frozen»|+ node_id\l+ ux, uy, rz\l+ settle_ux/uy/rz\l|+ prescribed(dof)\l}"];
    NodalLoad             [label="{NodalLoad «frozen»|+ node_id\l+ fx, fy, mz\l+ load_case\l}"];
    UniformDistributedLoad[label="{UniformDistributedLoad «frozen»|+ wy, wx\l+ coord_system\l+ load_case\l}"];
    PointLoad            [label="{PointLoad «frozen»|+ py, a, px\l+ coord_system\l+ load_case\l}"];
    TrussTemperatureLoad [label="{TrussTemperatureLoad «frozen»|+ delta_T\l+ load_case\l}"];
    FrameTemperatureLoad [label="{FrameTemperatureLoad «frozen»|+ t_top\l+ t_bottom\l+ load_case\l}"];
    LoadCase        [label="{LoadCase|+ name\l+ enabled\l}"];
    LoadCombination [label="{LoadCombination|+ name\l+ terms: dict\l}"];
    AnalysisResult  [fillcolor="#e6ffe6", label="{AnalysisResult|+ status\l+ warnings\l+ num_eq\l+ K, F, D\l+ residual\l+ member_results\l+ reactions\l+ eq_residual\l}"];
    MultiCaseAnalysisResult [fillcolor="#e6ffe6", label="{MultiCaseAnalysisResult|+ cases: dict\l+ active_case\l+ failed_cases\l|+ get(name)\l+ sum_all()\l+ combination(c)\l}"];

    /* ---------------- Element hierarchy (element.py) ---------------- */
    Element2D [fillcolor="#fff2cc", label="{Element2D «abstract»|+ id, node_i, node_j\l+ E, A, alpha, depth, rho\l+ section_id\l+ material_id_override\l+ member_loads: list\l|+ kind()\l+ raw_local_stiffness(nodes)*\l+ local_consistent_load(nodes)\l+ transformation_matrix(nodes)\l+ assembly_local_indices()\l+ global_stiffness_and_load(nodes)\l+ local_displacement_and_end_forces(...)\l}"];
    FrameElement2D [fillcolor="#fff2cc", label="{FrameElement2D|+ I\l+ release_i, release_j\l+ offset_i, offset_j\l|+ kind()=frame\l+ joint_local_stiffness(nodes)\l+ self_weight_fixed_end_local(nodes)\l}"];
    TrussElement2D [fillcolor="#fff2cc", label="{TrussElement2D|+ kind()=truss\l+ raw_local_stiffness(nodes)\l+ assembly_local_indices()\l}"];

    /* ---------------- Engine services ---------------- */
    DofManager   [fillcolor="#ffe6e6", label="{DofManager|+ active_map\l+ free_indices\l+ restrained_indices\l+ labels, n_total\l|+ from_model(model)\l+ index(node,dof)\l+ element_dof_map(elem)\l}"];
    assembler    [fillcolor="#ffe6e6", label="{«module» assembler|+ assemble_global_system(model)\l+ validate_model(model, dofs)\l}"];
    solver       [fillcolor="#ffe6e6", label="{«module» solver|+ solve_system(K,F,dofs,D_pre)\l}"];
    postprocessor[fillcolor="#ffe6e6", label="{«module» postprocessor|+ compute_member_forces(...)\l+ compute_reactions(...)\l+ equilibrium_check(...)\l}"];
    file_io      [fillcolor="#ffe6e6", label="{«module» file_io|+ read_input_file(path)\l}"];
    main         [fillcolor="#ffe6e6", label="{«module» main|+ run_analysis(model, case)\l+ run_multi_case_analysis(model)\l+ run_from_file(path)\l}"];
    modal        [fillcolor="#ffe6e6", label="{«module» modal|+ solve_modal(model)\l}"];

    /* ---------------- Editor + GUI ---------------- */
    Command [fillcolor="#ede7f6", label="{Command «abstract»|+ do(model)\l+ undo(model)\l}"];
    MainWindow [fillcolor="#ede7f6", label="{MainWindow (gui_qt.app)|+ model\l+ undo_stack\l|+ solve()\l+ push(cmd)\l}"];
    ModelCanvas [fillcolor="#ede7f6", label="{ModelCanvas (gui_qt.canvas)|+ redraw()\l+ select/highlight\l}"];
    Tool [fillcolor="#ede7f6", label="{Tool «abstract» (controllers)|+ on_click/key/release\l}"];
    element_graphics [fillcolor="#ede7f6", label="{«module» element_graphics|+ evaluate_internal_force(...)\l+ sample_internal_force(...)\l+ internal_force_at(...)\l}"];

    /* ---------------- Inheritance (hollow triangle) ---------------- */
    edge [arrowhead=onormal];
    FrameElement2D -> Element2D;
    TrussElement2D -> Element2D;

    /* ---------------- Composition (filled diamond at owner) ---------------- */
    edge [arrowhead=none, arrowtail=diamond, dir=back];
    StructuralModel -> "Node";
    StructuralModel -> Material;
    StructuralModel -> Section;
    StructuralModel -> Support;
    StructuralModel -> Element2D;
    StructuralModel -> NodalLoad;
    StructuralModel -> LoadCase;
    StructuralModel -> LoadCombination;
    MainWindow -> ModelCanvas;

    /* ---------------- Association / dependency (open arrow) ---------------- */
    edge [arrowhead=vee, arrowtail=none, dir=forward, style=dashed];
    Section -> Material [label="material_id"];
    Element2D -> Section [label="section_id"];
    FrameElement2D -> FrameTemperatureLoad [label="accepts"];
    TrussElement2D -> TrussTemperatureLoad [label="accepts"];
    DofManager -> StructuralModel [label="from"];
    assembler -> StructuralModel;
    assembler -> DofManager;
    solver -> DofManager;
    postprocessor -> DofManager;
    main -> file_io;
    main -> assembler;
    main -> solver;
    main -> postprocessor;
    main -> AnalysisResult [label="returns"];
    main -> MultiCaseAnalysisResult [label="returns"];
    modal -> StructuralModel;
    Command -> StructuralModel [label="do/undo"];
    MainWindow -> main [label="run"];
    MainWindow -> Command [label="push", style=solid, arrowhead=vee];
    ModelCanvas -> element_graphics [label="N/V/M"];
    Tool -> MainWindow [label="mutate"];
    element_graphics -> Element2D [label="reads f_local"];
}
